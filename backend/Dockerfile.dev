FROM eclipse-temurin:17-jdk-jammy

WORKDIR /app

# Install Maven and wget
RUN apt-get update && apt-get install -y maven wget && rm -rf /var/lib/apt/lists/*

# Download OpenTelemetry Java agent for auto-instrumentation
RUN wget -q https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.8.0/opentelemetry-javaagent.jar -O /app/opentelemetry-javaagent.jar

# Copy pom.xml (source will be volume-mounted at runtime)
COPY pom.xml .

# Copy source code (will be overridden by volume mount in dev)
COPY src ./src

# Expose application port and debug port
EXPOSE 8080 5005

# Run with spring-boot-devtools for hot-reload and OTel Java agent
CMD ["mvn", "spring-boot:run", \
     "-Dspring-boot.run.jvmArguments=-javaagent:/app/opentelemetry-javaagent.jar -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"]
